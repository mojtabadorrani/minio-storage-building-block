{
  "MinioStorage": {
    "Enabled": true,
    "Endpoint": "localhost:9100",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin123",
    "Bucket": "identity-users",
    "UseSsl": false,
    "PresignedUrlMinutes": 30,
    "MaxUploadBytes": 2097152,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
